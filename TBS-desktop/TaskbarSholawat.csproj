<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- TFM Windows SDK: Windows.Media.Control (GSMTC) di M3; 26100 diminta Deskband11Lib -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LibraryImport (P/Invoke Win32) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>TaskbarSholawat</AssemblyName>
    <RootNamespace>TaskbarSholawat</RootNamespace>
    <!-- PerMonitorV2 + supportedOS Win10: syarat jendela anak transparan di taskbar -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Build dilakukan dari WSL/Linux -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Satu .exe portable (PLAN bagian 7). Trimming WPF tidak didukung, jadi sengaja tidak dipakai. -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Font OFL (PLAN bagian 6), dimuat dari resource assembly -->
    <Resource Include="Fonts\Amiri-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Deskband11Lib.Wpf" Version="1.4.2" />
    <PackageReference Include="Raffinert.FuzzySharp" Version="6.0.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

</Project>
