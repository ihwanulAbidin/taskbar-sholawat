<Window x:Class="TaskbarSholawat.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskbar Sholawat" Width="480" Height="48"
        AllowsTransparency="True" Background="Transparent" WindowStyle="None"
        ShowInTaskbar="False">
    <!-- Mode A: jendela ini dijadikan anak Shell_TrayWnd oleh Deskband11Lib (TaskbarContentHost).
         Latar hampir transparan (bukan Transparent) supaya klik kanan tetap tertangkap. -->
    <Grid x:Name="Root" Background="#01000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Keluar" Click="OnExitClick" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Baris Arab mengecil sendiri bila tidak muat (lebar celah taskbar / tinggi baris) -->
        <!-- Margin atas 2 px: harakat bertumpuk (syaddah + fathah) Amiri menyentuh batas kotak baris -->
        <Viewbox Grid.Row="0" Margin="8,2,8,0" Stretch="Uniform" StretchDirection="DownOnly">
            <TextBlock x:Name="Arabic"
                       FlowDirection="RightToLeft"
                       FontFamily="pack://application:,,,/Fonts/#Amiri"
                       FontSize="20" />
        </Viewbox>

        <TextBlock x:Name="Translation" Grid.Row="1"
                   Margin="8,0,8,3"
                   FontFamily="Segoe UI" FontSize="11" Opacity="0.8"
                   LineHeight="13" LineStackingStrategy="BlockLineHeight"
                   TextAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
